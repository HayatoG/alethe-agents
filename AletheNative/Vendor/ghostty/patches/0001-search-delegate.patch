+
+/// Search requests and progress (Alethe patch). Ghostty asks the host to show
+/// or hide its search UI (`start_search`, e.g. ⌘F; `end_search`) and reports
+/// progress of `search:` / `navigate_search:`: `total` is nil while no search
+/// runs; `selected` is the 0-based index of the current match, nil when none.
+@MainActor
+public protocol TerminalSurfaceSearchDelegate: TerminalSurfaceViewDelegate {
+    func terminalDidRequestSearch(needle: String)
+    func terminalDidEndSearch()
+    func terminalDidUpdateSearchTotal(_ total: Int?)
+    func terminalDidUpdateSearchSelected(_ selected: Int?)
+}
